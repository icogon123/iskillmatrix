{
  "name": "aroviaskilltech-backend",
  "version": "1.0.0",
  "private": true,
  "description": "AroviaSkillTech linear (unilevel) MLM management API",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "NODE_ENV=production node src/server.js",
    "seed": "node src/scripts/seed.js",
    "test:engine": "MAIL_LOG=off node src/scripts/engineCheck.js",
    "test:prod": "NODE_ENV=production MAIL_LOG=off node src/scripts/prodCheck.js",
    "migrate:uploads": "node src/scripts/migrateUploads.js",
    "test:storage": "node src/scripts/storageCheck.js",
    "test:api": "MAIL_LOG=off node src/scripts/apiCheck.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.4",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.14",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}
